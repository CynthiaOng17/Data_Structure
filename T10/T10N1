public class Q1 {
    public int linearSearch(int [] list, int key){
        for(int i = 0; i < list.length; i++){
            if(list[i] == key){
                return i;
            }
        }return -1;
    }
    
    public int binarySearch(int [] list, int key){
        
        int high = list.length-1; 
        int low = 0;
        
        while(high >= low){
            int mid = (low + high) / 2;
            
            if(key > list[mid]){
                low = mid + 1;
            }else if(key < list [mid]){
                high = mid - 1;
            }else
                return mid;
        }
        return -1;
    }
}
