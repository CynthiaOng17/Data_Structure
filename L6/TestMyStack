public class TestMyStack {
    public static void main (String [] args){
        MyStack <Character> stack = new MyStack<>();
        stack.push('a');
        stack.push('b');
        stack.push('c');
        System.out.println(stack.toString()); // Print the stack
        System.out.println("Found 'b': " + stack.search('b')); // Search for 'b'
        System.out.println("Found 'k': " + stack.search('k')); // Search for 'k'
        
        MyStack <Integer> stack2 = new MyStack<>();
        stack2.push(1);
        stack2.push(2);
        stack2.push(3);
        System.out.println(stack2.toString());
        System.out.println("Found 6: " + stack.search((char)6));
    }
}
