public class Main <E>{
    
    public static int sumOfStackElements(MyStack<Integer> stack){
        int sum = 0;
        while(! stack.isEmpty()){
            sum += stack.pop();
        }
        return sum;
    }
    
    public static void main(String[] args) {
  
        MyStack <Integer> S = new MyStack<>();
        S.push(1);
        S.push(2);
        S.push(3);
        S.push(4);
        S.push(5);
        
        int sum = sumOfStackElements(S);
        System.out.println("Sum of all elements in the stack: " + sum);
    }
}
