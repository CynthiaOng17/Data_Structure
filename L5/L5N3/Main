public class L5N3 {

    public static void main(String[] args) {
        DoubleLinkedList<Integer> list = new DoubleLinkedList<>();
        list.addFirst(1);
        list.addLast(100);
        list.add(2,2);
        list.remove(3);
        list.IterateForward();
        list.IterateBackward();
        list.getSize();
        list.clear();
        list.getSize();
    }
}
