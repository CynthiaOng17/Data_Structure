import java.util.Scanner;
public class TestSinglyLinkedList {
    private static SinglyLinkedList <String> studentList = new SinglyLinkedList<>();
    private static Scanner sc = new Scanner(System.in);
    
    public static void main (String[] args){
        boolean exit = false;
        
        while(!exit){
            displayMenu();
            int choice = getUserChoice();
            switch(choice){
                case 1:
                    addStudent();
                    break;
                case 2:
                    removeStudent();
                    break;
                case 3:
                    displayStudents();
                    break;
                case 4:
                    calculateSize();
                    break;
                case 5:
                    replaceStudentName();
                    break;
                case 6:
                    exit = true;
                    System.out.println("Existing...");
                    break;
                default:
                    System.out.println("Imvalid choice. Please enter a number from 1 to 6.");
            }
        }
        sc.close();
    }
        
    private static void displayMenu(){
        System.out.println("\n--- Student Management System Menu ---");
        System.out.println("1. Add Student");
        System.out.println("2. Remove Student");
        System.out.println("3. Display Students");
        System.out.println("4. Calculate Number of Students");
        System.out.println("5. Replace Student Name");
        System.out.println("6. Exit");
        System.out.println("Enter your choice: ");
    }
    private static int getUserChoice(){
        while(!sc.hasNextInt()){
            System.out.println("Invalid input. Please enter a number.");
            sc.next();
        }
        return sc.nextInt();
    }
    private static void addStudent(){
        System.out.println("Enter the students' name: ");
        String name = sc.nextLine();
        name = sc.nextLine();
        studentList.add(name);
        System.out.println("Student added successfully.");
    }
    
    private static void removeStudent(){
        System.out.println("Enter the student's name to remove: ");
        String name = sc.nextLine();
        name = sc.nextLine();
        if(studentList.contains(name)){
            studentList.removeElement(name);
            System.out.println("Student removed successfully.");
        }else{
            System.out.println("Student not found.");
        }
    }
    
    private static void calculateSize(){
        System.out.println("Number of students: "+ studentList.getSize());
    }
    
    private static void replaceStudentName(){
        System.out.println("Enter the student's name to be replaced: ");
        String oldName = sc.nextLine();
        oldName = sc.nextLine();
        if(studentList.contains(oldName)){
            System.out.println("Enter the new name: ");
            String newName = sc.nextLine();
            studentList.replace(oldName, newName);
            System.out.println("Student name replaced successfully.");
        }else{
            System.out.println("Student not found.");
        }
    }
    private static void displayStudents(){
        if(studentList.getSize() == 0){
            System.out.println("No students in the list.");
        }else{
            System.out.println("List of student names:");
            studentList.printList();
        }
    }
