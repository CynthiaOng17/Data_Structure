public class L9N1 {
    
    public static void main(String[] args) {
        System.out.println(substituteAI("flabbergasted"));
        System.out.println(substituteAI("Astronaut")); 
    }
    
    public static String substituteAI(String str){
        if (str.isEmpty()) {
            return str;
        }
        char firstChar = str.charAt(0);
        if (firstChar == 'a') {
            firstChar = 'i';
        }

        // Recursive call on the rest of the string
        return firstChar + substituteAI(str.substring(1));
    }
}
