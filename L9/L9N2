public class L9N2 {
    public static void permuteString(String input) {
        permuteString("", input);
    }

    private static void permuteString(String prefix, String str) {
        int n = str.length();
        if (n == 0) {
            System.out.println(prefix);
        } else {
            for (int i = 0; i < n; i++) {
                permuteString(prefix + str.charAt(i), str.substring(0, i) + str.substring(i + 1, n));
            }
        }
    }
    
    public static void main (String [] args){
        permuteString("ABC");
    }
}
