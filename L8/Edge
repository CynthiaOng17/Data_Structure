public class Edge<T extends Comparable<T>, N extends Comparable<N>> {
    Vertex<T, N> toVertex;
    N weight;
    Edge<T, N> nextEdge;

    public Edge() {
        this.toVertex = null;
        this.weight = null;
        this.nextEdge = null;
    }

    public Edge(Vertex<T, N> destination, N w, Edge<T, N> e) {
        this.toVertex = destination;
        this.weight = w;
        this.nextEdge = e;
    }
}
