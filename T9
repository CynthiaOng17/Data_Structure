import java.util.Scanner;
public class T9 {

    public static void main(String[] args) {
        System.out.println("Enter a string to reverse: ");
        Scanner sc = new Scanner (System.in);
        String input = sc.nextLine();
        System.out.println("Original string: "+input);
        System.out.println("Reverse string: "+reverseString(input));
        
        int number = 5;
        System.out.println("Sum of 5: "+sum(number));
        
        System.out.println("Print digit 4567: "+printDigit("4567"));
    }
    
    public static String reverseString(String str) {
        // Base case: if the string is empty or has only one character, it's already reversed
        if (str == null || str.length() <= 1) {
            return str;
        }

        // Recursive case: reverse the rest of the string and append the first character at the end
        return reverseString(str.substring(1)) + str.charAt(0);
    }
    
      public static int sum(int N) {
        // Base case
        if (N == 0) {
            return 0;
        }
        // Recursive case
        return N + sum(N - 1);
    }
      public static void printDigit(int N) {
        // Base case: if N is a single-digit number
        if (N < 10) {
            System.out.print(N);
            return;
        }

        // Recursive case: print the digits of the number
        printDigit(N / 10);
        System.out.print(" " + (N % 10));
    }
      
      public static String printDigit(String N){
          if(N.length()> 0){
               return N.charAt(0)+" "+printDigit(N.substring(1));
          }
          return "";
      }
}
