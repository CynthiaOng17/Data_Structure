public class Tutorial4 <E>	{
    
        static Node<Character> node1 = new Node<Character>('k');
	static Node<Character> node2 = new Node<Character>('p');
	//@SuppressWarnings("unchecked")
	static Node<Character> head = null;
	static Node<Character> tail = null;
	private int size;
        
	public static void main (String[] args)	{
		// Q1c
		head=node1;
		tail=node2;
		head.next=tail;
			
		// Q1e - condition 1: only firstNode exist
		//       condition 2: there are some nodes in the list.
		
		// Q1f test
                //addFirst
		Character charAdd='f';
		addFirst(charAdd);
		printList();

		charAdd='d';
		addFirst(charAdd);
		printList();
		
                //addLast
		charAdd='x';
		addLast(charAdd);
		printList();

		charAdd='z';
		addLast(charAdd);
		printList();
		
                //addMid
		charAdd='a';
		addMid(1,charAdd);
		printList();

		charAdd='b';
		addMid(2,charAdd);
		printList();
		
		charAdd='j';
		addMid(5,charAdd);
		printList();

		charAdd='A';
		addMid(25,charAdd);
		printList();
		
                //removeFirst
		removeFirst();
		removeFirst();
		printList();
                
                //removeLast
		removeLast();
		printList();

		removeLast();
		printList();
                
                //remove
		remove(1);
		printList();

		remove(3);
		printList();
                remove(5);
		printList();
				
	}
	
	// Q1g - add new node to the first location
	public static void addFirst(Character e) {
		Node<Character> firstNode = new Node<>(e);
		if (head==null) 
			head = tail = firstNode;
		else {
			firstNode.next = head;
			head = firstNode;
		}
	}
	
	// Q1h_i - add new node to the last location
	public static void addLast(Character e) {
		Node<Character> lastNode = new Node<>(e);
		if (tail==null) 
			head = tail = lastNode;
		else {
			tail.next = lastNode;
			tail=lastNode;
		}
	}
	
	// Q1h_ii
	public static void addMid(int x, Character e) {
		Node<Character> midNode = new Node<>(e);
		
		if (head==null) 
                    head = tail = midNode;
		else if (x<=1) 
			addFirst(e);
		else {
			Node<Character> current = head;
			int i=1;
			while (current.next!=null && i<x-1)	{
				current=current.next;
				i++;
			}
			midNode.next = current.next;
			current.next = midNode;
		}
	}
	
	// Q1h_iii
	public static void removeFirst()	{
		if (head!=null)
			head=head.next;
	}

	// Q1h_iii
	public static void removeLast()	{
		if (head!=null) {
			Node<Character> current = head;
			while (current.next.next!=null)
				current=current.next;
			tail=current;
			current.next=null;
		}
	}
        
		// additional
	public static void printList()	{
		Node<Character> current = head;
		while (current.next!=null)	{
			System.out.print(" >> " + current.e );
			current=current.next;
		}
		System.out.println( " >> " + current.e);
	}

	public static void remove(int x) {
		if (head==null) 
			head = tail = null;
		else if (x<=1) 
			removeFirst();
		else {
			Node<Character> iter = head;
			int i=1;
			while (iter.next!=null && i<x-1)	{
				iter=iter.next;
				i++;
			}
			if (iter.next!=null)
				iter.next = iter.next.next;
			else
				removeLast();
		}
	}
	
	
}
