interface Account{
    public int deposit(int x);
    public Boolean withdraw(int y);
}

class BankAccount implements Account{
    double balance;
    
    BankAccount(int balance){
        this.balance = balance;
    }
    
    public int deposit(int dep){
        return (int) (balance+dep);
    }
     public Boolean withdraw(int y){
         if(y <= balance){
             this.balance = balance - y;
             return true;
         }
         return false;
     }
}
